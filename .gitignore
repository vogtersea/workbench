# ---------- 运行时数据（绝不入库）----------
.venv/
data/
.env
backup/
__pycache__/
*.pyc
.playwright/

# ---------- 测试与静态检查产物 ----------
.pytest_cache/
.ruff_cache/
coverage.xml
.coverage

# ---------- 桌面版构建产物（体积大，用 scripts/build_desktop.sh 重建）----------
build/
dist/
*.spec.bak

# ---------- 本地调试生成的报告 ----------
*.docx

# 本地敏感词表（绝不入库：扫描词本身即泄露源）
.privacy-terms.txt

# ---------- Android 工程 ----------
# 构建期由 scripts/build_apk.sh 从 app/ 同步进来，不入库（避免两边代码漂移）
android/app/src/main/python/app/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.keystore
