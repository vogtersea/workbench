# ============================================================
# 工作台项目 · 环境变量样例
# 用法：cp .env.example .env ，然后按需修改。
# .env 已在 .gitignore 中，绝不提交；密钥只从这里读，绝不写库。
# 所有键都可省略：省略即使用下面的默认值。
# ============================================================

# ---------- 基础 ----------
# 数据目录，SQLite 数据库位于 DATA_DIR/app.db
# Docker 部署固定为 /data（对应 compose 里的 ./data:/data）
DATA_DIR=./data

# 业务时区：影响「今天」的判定、每日扫描时刻、DDL 逾期天数
TZ_NAME=Asia/Shanghai

# 容器内 HTTP 监听端口（uvicorn 命令行参数）。
# 注意：宿主机对外端口由下面的 APP_PORT 决定，容器内始终 8080。
PORT=8080

# 宿主机对外端口（可改成任意非标准端口，例如 18080）
APP_PORT=8080

# ---------- 鉴权（内网自用可留空） ----------
# 非空即启用口令登录；留空 = 完全不鉴权
# 首个管理员的密码来源：多用户模式首次启动时用它创建管理员账号。
# 管理员用户名默认为 admin，可用下面这行改为其它名字。
APP_PASSWORD=
APP_ADMIN_USER=admin

# 会话签名密钥；留空时首次启动自动生成并落盘 DATA_DIR/.secret
# 生产建议显式填写 32 字节以上随机串：python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=

# ---------- Obsidian 只读接入 ----------
# vault 目录；不存在则自动禁用该功能（Docker 部署固定为 /vault）
VAULT_DIR=/vault

# ---------- 大模型（OpenAI 兼容接口） ----------
# 兼容 DeepSeek / OpenAI / Ollama / vLLM 等：只改 base + key + model 即可
LLM_BASE_URL=https://api.deepseek.com/v1
# 留空即 MOCK 模式：报告用确定性模板渲染，并在正文首行标注 MOCK
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 单次请求超时（秒）
LLM_TIMEOUT=120
# 单次生成最大 token 数
LLM_MAX_TOKENS=2000
# 采样温度
LLM_TEMPERATURE=0.3

# ---------- 每日提醒 ----------
# 每日扫描时刻 HH:MM（业务时区）；设置页里保存的值优先于这里
REMIND_TIME=09:00

# Webhook 地址；留空 = 只做站内提醒（不对外推送）
# 支持的 6 种格式由设置页的「Webhook 格式」选择：generic_json / wecom_text /
# feishu_text / serverchan / telegram / bark
WEBHOOK_URL=

# ---------- 安全与导出（W-02 / W-01）----------
# 通过 HTTPS 反向代理访问时置 1：会话 Cookie 带 Secure，浏览器不再明文回传。
# 直连 http://NAS:端口 时必须保持 0，否则登录后会立刻掉线。
SECURE_COOKIE=0

# 报告 docx 导出总开关；置 0 时 /reports/{id}/export.docx 返回 404，页面不显示「下载 Word」按钮
EXPORT_DOCX=1
